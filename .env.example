# Copy to .env and fill secrets. Never commit .env (gitignored).
ENVIRONMENT=development
APP_NAME=Auto System Agent API
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-long-random-value
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=change-me
TOKEN_TTL_MINUTES=60
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
# Optional full override, e.g. postgresql://user:pass@db:5432/postgres
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
